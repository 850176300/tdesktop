	textFg: introTitleFg;
	align: align(top);
	minWidth: introQrTitleWidth;
	style: TextStyle(defaultTextStyle) {
		font: font(20px semibold);
	}
}
introQrErrorTop: 336px;
introQrTitleTop: 196px;
